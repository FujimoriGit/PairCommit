    "criteriaReview.failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t check the criteria right now."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いまは下読みできませんでした。"
          }
        }
      }
    },
    "criteriaReview.instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are a goal-setting advisor. Check whether the given success criteria are written so that a third party could judge, on the deadline, whether they were achieved.\nThey can be judged if they include numbers, dates, or observable facts.\nThey can't be judged if they only use subjective words such as \"try hard\" or \"keep in mind\".\nWrite the advice in English as one sentence of no more than 25 words."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは目標設定の相談相手です。渡された達成基準が、期日に第三者から見て\n達成できたかどうかを判定できる書き方になっているかを見てください。\n数値・期日・観測できる事実が入っていれば判定できます。\n「頑張る」「意識する」のような主観的な表現しかないものは判定できません。\n助言は日本語で、60字以内の1文にしてください。"
          }
        }
      }
    },
    "criteriaReview.prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vision: %1$@\nSuccess criteria: %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビジョン: %@\n達成基準: %@"
          }
        }
      }
    },
    "criteriaReview.request" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
