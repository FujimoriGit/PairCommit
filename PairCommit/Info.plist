	<string>Two at the Mast</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ja</string>
	</array>
	<key>CKSharingSupported</key>
	<true/>
	<key>NSBonjourServices</key>
